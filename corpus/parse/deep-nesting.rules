rules_version = '2';

// Deep nesting: orgs → projects → tasks → comments, plus overlapping blocks and a catch-all.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /orgs/{orgId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }

      allow get: if isMember();
      allow list: if false;

      match /projects/{projectId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.resource.data.orgId == orgId;

        match /tasks/{taskId} {
          allow read: if signedIn();
          allow create: if signedIn() && request.resource.data.assignee == request.auth.uid;
          allow update: if signedIn() && resource.data.assignee == request.auth.uid;
          allow delete: if false;

          match /comments/{commentId} {
            allow read: if signedIn();
            allow create: if signedIn() && request.resource.data.author == request.auth.uid;
            allow update, delete: if signedIn() && resource.data.author == request.auth.uid;
          }
        }
      }
    }

    // Overlaps /orgs/{orgId}/projects/{projectId}: either block can allow.
    match /orgs/{orgId}/projects/{projectId} {
      allow update: if signedIn() && request.auth.token.org_admin == orgId;
    }

    match /public/{path=**} {
      allow read;
    }
  }
}
