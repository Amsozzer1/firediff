# TLS certificates come from Let's Encrypt automatically once DNS points here.
# No access log: Caddy doesn't log requests unless told to, so client addresses aren't stored.
{$PLAYGROUND_DOMAIN} {
	encode zstd gzip
	request_body {
		# Two 64 KB rules files and 8 KB of config, JSON-escaped, with room to spare.
		max_size 300KB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy firediff:8787
}
